# Base URL prepended to every API call by the axios client.
#
# Local dev — use the Vite proxy (default).
#   The dev server proxies /api/* to VITE_DEV_API_PROXY_TARGET (see vite.config.ts).
#   No CORS, cookies work naturally.
VITE_API_BASE_URL=/api

# If you'd rather point at the backend directly (skipping the proxy), use an absolute URL —
# the backend must then send Access-Control-Allow-Origin: http://localhost:9000 and
# Access-Control-Allow-Credentials: true.
# VITE_API_BASE_URL=http://localhost:9090

# Where the Vite dev server proxies /api/* to. Only used in dev. Optional — defaults to
# http://localhost:9090 (matches the port shown in the login error trace).
# VITE_DEV_API_PROXY_TARGET=http://localhost:9090

# Staging / production examples (real absolute URLs, no proxy):
# VITE_API_BASE_URL=https://staging.api.mimir.app
# VITE_API_BASE_URL=https://api.mimir.app

# Set to "true" to run the app against MSW handlers (src/mocks/) instead of a
# real backend. Only honoured in dev builds. Useful for offline UI work.
# VITE_ENABLE_MOCKS=true
