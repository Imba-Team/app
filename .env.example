# Application
PORT=9090
SERVICE_NAME=monolith
NODE_ENV=development

# Authentication
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# PostgreSQL (used by docker-compose)
POSTGRES_USER=mimir
POSTGRES_PASSWORD=mimir
POSTGRES_DB=mimir
POSTGRES_PORT=5432

# Prisma connection string (points at the docker-compose Postgres by default)
DATABASE_URL=postgresql://mimir:mimir@localhost:5432/mimir?schema=public

# Legacy DB vars (kept for compatibility with existing code paths)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=mimir
DATABASE_PASSWORD=mimir
DATABASE_NAME=mimir

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_PORT=9200

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=mimir

# ClickHouse (analytics)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9009
CLICKHOUSE_DB=mimir_analytics
CLICKHOUSE_USER=mimir
CLICKHOUSE_PASSWORD=mimir

# Mail Configuration
MAIL_HOST=smtp.your-email-provider.com
MAIL_PORT=587
MAIL_SECURE=false # true for SSL, false for STARTTLS
MAIL_USER=your@email.com
MAIL_PASSWORD=your_email_password

# Cookie Configuration
COOKIE_EXPIRES_IN=604800000 # in milliseconds (7 days)

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Anthropic (AI features — Sprint 9)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Monitoring (docker-compose.monitoring.yml)
PROMETHEUS_PORT=9091
LOKI_PORT=3100
GRAFANA_PORT=3000
CADVISOR_PORT=8081
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Observability service identification labels
OTEL_SERVICE_NAME=mimir-api
