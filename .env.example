# Application
# SERVER_PORT — NestJS API (apps/server). PORT is kept as a fallback for
# hosts that inject a single PORT env (Render, Railway, Heroku).
SERVER_PORT=9090
PORT=9090
# WEB_PORT — Next.js dev/prod server (apps/web).
WEB_PORT=3000
SERVICE_NAME=mimir-api
NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# Authentication — JWT keys (RS256)
# ─────────────────────────────────────────────────────────────
# In production, set EITHER the raw PEM contents (multiline ok), OR the
# base64-encoded PEMs (recommended for platforms that mangle newlines
# like Render / Vercel / Railway), OR file paths to mounted secret files.
# If none are provided in production, the app REFUSES to boot — in dev
# it generates an ephemeral keypair and logs a warning.
#
# Generate a pair:
#   openssl genrsa -out jwt-private.pem 2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
#   base64 -i jwt-private.pem   → JWT_PRIVATE_KEY_BASE64
#   base64 -i jwt-public.pem    → JWT_PUBLIC_KEY_BASE64
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# Issuer claim baked into every access token and verified on every request.
JWT_ISSUER=mimir-api
# Access-token TTL (short — must be refreshed). Format: 15m / 30s / 1h / 2d
JWT_ACCESS_TTL=15m
# Refresh-token TTL in days.
JWT_REFRESH_TTL_DAYS=30

# DEPRECATED — only read as a no-op placeholder for older deployments.
# Migrate to JWT_PRIVATE_KEY / JWT_PUBLIC_KEY (RS256).
JWT_SECRET=
JWT_EXPIRES_IN=

# Authentication — login lockout (per-account, Redis-backed)
# After N consecutive failed login attempts, the account is locked for
# LOGIN_LOCKOUT_MINUTES. Counter resets on successful login.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Rate limiting (per-IP, in-memory by default — per-pod, not per-cluster).
# The default throttler applies to every route; the @Throttle()
# decorator overrides limits per auth-controller endpoint.
DEFAULT_THROTTLE_LIMIT=100
DEFAULT_THROTTLE_TTL_SECONDS=60

# ─────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────
# docker-compose only — ignored when DATABASE_URL points at a hosted DB.
POSTGRES_USER=mimir
POSTGRES_PASSWORD=mimir
POSTGRES_DB=mimir
POSTGRES_PORT=5432

# Prisma connection strings.
#
# Local dev (docker-compose Postgres):
#   DATABASE_URL=postgresql://mimir:mimir@localhost:5432/mimir?schema=public
#   DATABASE_URL_UNPOOLED=postgresql://mimir:mimir@localhost:5432/mimir?schema=public
#
# Neon (pooled + direct). The pooled URL uses the `-pooler` host and is what
# the app uses at runtime. The unpooled URL is what Prisma Migrate uses
# (advisory locks / prepared statements don't work through PgBouncer).
#   DATABASE_URL="postgresql://<user>:<pw>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require"
#   DATABASE_URL_UNPOOLED="postgresql://<user>:<pw>@<host>.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require"
#
# Render Postgres: use the "Internal Database URL" for both.
DATABASE_URL=postgresql://mimir:mimir@localhost:5432/mimir?schema=public
DATABASE_URL_UNPOOLED=postgresql://mimir:mimir@localhost:5432/mimir?schema=public

# Legacy DB vars (kept for compatibility with existing code paths)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=mimir
DATABASE_PASSWORD=mimir
DATABASE_NAME=mimir

# ─────────────────────────────────────────────────────────────
# Redis (BullMQ mail queue + login lockout counter)
# ─────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Only set if your Redis instance is auth-enabled (local docker-compose isn't).
REDIS_PASSWORD=

# ─────────────────────────────────────────────────────────────
# Elasticsearch (search — optional at boot)
# ─────────────────────────────────────────────────────────────
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_PORT=9200

# ─────────────────────────────────────────────────────────────
# Object storage (S3-compatible: MinIO / Cloudflare R2 / AWS S3)
# ─────────────────────────────────────────────────────────────
# STORAGE_PROVIDER controls provider-specific boot behavior:
#   - minio (default): creates the bucket + sets a public-read policy on boot.
#   - r2:              skips bucket create + policy (managed via Cloudflare
#                      dashboard); public URLs omit the bucket segment.
#   - s3:              same as r2 — bucket/policy managed out-of-band.
STORAGE_PROVIDER=minio
# Optional. Defaults: "us-east-1" for minio/s3, "auto" for r2.
STORAGE_REGION=

# S3 API endpoint. For MinIO this is your container host; for R2 it's
# <account-id>.r2.cloudflarestorage.com.
# Mimir's docker-compose MinIO uses non-default host ports (9002/9003)
# so it doesn't clash with another project's MinIO on 9000.
MINIO_ENDPOINT_HOST=localhost
MINIO_ENDPOINT_PORT=9002
MINIO_USE_SSL=false
MINIO_CONSOLE_PORT=9003

# Credentials — REQUIRED in production. The app refuses to boot with
# the old minioadmin/minioadmin defaults when NODE_ENV=production.
# For R2 these are the API token's Access Key ID / Secret Access Key.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Shared bucket. Prefixes inside it ('avatars/', 'study-set-audio/' etc.)
# separate concerns without per-bucket policies.
MINIO_BUCKET=mimir

# Public URL the FE / browser uses to read objects.
#   - MinIO dev:    http://localhost:9002        (app appends /<bucket>/<key>)
#   - R2 dev URL:   https://pub-<hash>.r2.dev    (app appends /<key>, no bucket)
#   - R2 custom:    https://cdn.mimir.app        (app appends /<key>, no bucket)
MINIO_PUBLIC_URL=http://localhost:9002

# Legacy MinIO env vars (kept for backwards compatibility with docker-compose)
MINIO_ENDPOINT=http://localhost:9002
MINIO_PORT=9002

# ─────────────────────────────────────────────────────────────
# ClickHouse (analytics — not wired to prod)
# ─────────────────────────────────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9009
CLICKHOUSE_DB=mimir_analytics
CLICKHOUSE_USER=mimir
CLICKHOUSE_PASSWORD=mimir

# ─────────────────────────────────────────────────────────────
# Mail
# ─────────────────────────────────────────────────────────────
# Production transport (HTTP, recommended).
# If set, MailService routes via @sendgrid/mail. The SMTP block below is ignored.
SENDGRID_API_KEY=

# From-address applied to every outbound transactional email. Must be a
# verified sender in SendGrid (or a real mailbox you control in SMTP mode).
MAIL_FROM=no-reply@mimir.local
# Legacy alias read as a fallback for MAIL_FROM
NO_REPLY_MAIL=no-reply@mimir.local

# SMTP fallback (development only). Used when SENDGRID_API_KEY is unset.
# Point at Mailpit / MailHog locally — no real outbound delivery needed.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false # true for SSL, false for STARTTLS
MAIL_USER=
MAIL_PASSWORD=

# BullMQ — number of mail jobs processed concurrently by one worker.
MAIL_QUEUE_CONCURRENCY=5

# ─────────────────────────────────────────────────────────────
# URLs (email links, OAuth redirects, CORS)
# ─────────────────────────────────────────────────────────────
# Frontend base URL used when building magic-link / verification URLs.
# Email links point at <FRONTEND_BASE_URL>/auth/verify-email?token=...
# REQUIRED in production — the app refuses to send emails with localhost
# links when NODE_ENV=production.
FRONTEND_BASE_URL=http://localhost:3000
# Legacy alias still read as a fallback if FRONTEND_BASE_URL is not set.
BASE_URL=http://localhost:3000

# Where the backend redirects the browser after a successful OAuth handshake.
# Format: <frontend-origin>. The controller appends /auth/callback/<provider>?ok=1.
FRONTEND_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins (added to the built-in
# localhost + mimir.app defaults). Set to your web app's origin(s) in prod.
#   CORS_ORIGINS=https://mimir.app,https://www.mimir.app
CORS_ORIGINS=

# Cookie Configuration
COOKIE_EXPIRES_IN=604800000 # in milliseconds (7 days)

# ─────────────────────────────────────────────────────────────
# Google OAuth
# ─────────────────────────────────────────────────────────────
# REQUIRED in production. The app refuses to boot with placeholder /
# localhost values when NODE_ENV=production.
# Callback URL must match what's registered in the Google Cloud Console:
#   https://<api-host>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ─────────────────────────────────────────────────────────────
# Anthropic (AI features)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─────────────────────────────────────────────────────────────
# Monitoring (docker-compose.monitoring.yml — self-hosted stack)
# ─────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
LOKI_PORT=3100
GRAFANA_PORT=3000
CADVISOR_PORT=8081
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Observability service identification labels
OTEL_SERVICE_NAME=mimir-api

# ─────────────────────────────────────────────────────────────
# Web (Next.js)
# ─────────────────────────────────────────────────────────────
# Backend URL the browser hits. Inlined at build time by Next — a per-env
# build is required if the value differs between staging and prod.
NEXT_PUBLIC_API_BASE_URL=http://localhost:9090
# Comma-separated https hostnames allowed for next/image remote loading.
# Add your R2 public host (pub-<hash>.r2.dev) or CDN domain here.
NEXT_PUBLIC_IMAGE_HOSTS=imba-server.up.railway.app
