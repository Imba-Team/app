# Application
PORT=9090
SERVICE_NAME=monolith
NODE_ENV=development

# Authentication — JWT keys (RS256)
# In production, set EITHER the raw PEM contents (multiline ok), OR the
# base64-encoded PEMs (useful for secret managers that mangle newlines),
# OR file paths to mounted secret files. If none are provided, the app
# generates an ephemeral keypair at boot and logs a loud warning — fine
# for local dev, never use this in production.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# Issuer claim baked into every access token and verified on every request.
JWT_ISSUER=mimir-api
# Access-token TTL (short — must be refreshed). Format: 15m / 30s / 1h / 2d
JWT_ACCESS_TTL=15m
# Refresh-token TTL in days.
JWT_REFRESH_TTL_DAYS=30

# DEPRECATED — only read as a no-op placeholder for older deployments.
# Migrate to JWT_PRIVATE_KEY / JWT_PUBLIC_KEY (RS256).
JWT_SECRET=
JWT_EXPIRES_IN=

# Authentication — login lockout (per-account, Redis-backed)
# After N consecutive failed login attempts, the account is locked for
# LOGIN_LOCKOUT_MINUTES. Counter resets on successful login.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Rate limiting (per-IP, in-memory by default)
# The default throttler applies to every route; the @Throttle()
# decorator overrides limits per auth-controller endpoint.
DEFAULT_THROTTLE_LIMIT=100
DEFAULT_THROTTLE_TTL_SECONDS=60

# PostgreSQL (used by docker-compose)
POSTGRES_USER=mimir
POSTGRES_PASSWORD=mimir
POSTGRES_DB=mimir
POSTGRES_PORT=5432

# Prisma connection string (points at the docker-compose Postgres by default)
DATABASE_URL=postgresql://mimir:mimir@localhost:5432/mimir?schema=public

# Legacy DB vars (kept for compatibility with existing code paths)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=mimir
DATABASE_PASSWORD=mimir
DATABASE_NAME=mimir

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_PORT=9200

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=mimir

# ClickHouse (analytics)
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9009
CLICKHOUSE_DB=mimir_analytics
CLICKHOUSE_USER=mimir
CLICKHOUSE_PASSWORD=mimir

# Mail — production transport (HTTP, recommended).
# If set, MailService routes via @sendgrid/mail. The SMTP block below is ignored.
SENDGRID_API_KEY=

# From-address applied to every outbound transactional email. Must be a
# verified sender in SendGrid (or a real mailbox you control in SMTP mode).
MAIL_FROM=no-reply@mimir.local
# Legacy alias read as a fallback for MAIL_FROM
NO_REPLY_MAIL=no-reply@mimir.local

# Mail — SMTP fallback (development only). Used when SENDGRID_API_KEY is unset.
# Point at Mailpit / MailHog locally — no real outbound delivery needed.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false # true for SSL, false for STARTTLS
MAIL_USER=
MAIL_PASSWORD=

# BullMQ — number of mail jobs processed concurrently by one worker.
MAIL_QUEUE_CONCURRENCY=5

# Redis password (only set if your Redis is auth-enabled — local docker-compose isn't)
REDIS_PASSWORD=

# Frontend base URL used when building magic-link / verification URLs.
# Email links point at <FRONTEND_BASE_URL>/auth/verify-email?token=...
FRONTEND_BASE_URL=http://localhost:5173
# Legacy alias still read as a fallback if FRONTEND_BASE_URL is not set
BASE_URL=http://localhost:5173

# Cookie Configuration
COOKIE_EXPIRES_IN=604800000 # in milliseconds (7 days)

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Anthropic (AI features — Sprint 9)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Monitoring (docker-compose.monitoring.yml)
PROMETHEUS_PORT=9091
LOKI_PORT=3100
GRAFANA_PORT=3000
CADVISOR_PORT=8081
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Observability service identification labels
OTEL_SERVICE_NAME=mimir-api
